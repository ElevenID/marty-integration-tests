{
  "schema": "elevenid.eudi-reference-interop/v1",
  "review_cadence": "monthly",
  "components": {
    "verifier_endpoint": {
      "repository": "https://github.com/eu-digital-identity-wallet/eudi-srv-verifier-endpoint.git",
      "release": "v0.11.0",
      "commit": "2bc0bd98a81742db321e96d31d88142128006422",
      "image": "ghcr.io/eu-digital-identity-wallet/eudi-srv-verifier-endpoint@sha256:2f2772b1df39a529f3683c7e82d10d03221b475e67da7b2d8cb1b9aebe6f71f9"
    },
    "wallet_kit": {
      "implementation": "ElevenID HTTP test facade over official EUDI JVM libraries",
      "build": {
        "dockerfile": "services/eudi-wallet-harness/Dockerfile",
        "builder_image": "docker.io/library/gradle:8.11-jdk17@sha256:91d559b8d55f522de5bc6882f73bcedc4e2cc7b0a58e839a9fa0ed95811a988d",
        "runtime_image": "docker.io/library/eclipse-temurin:17-jre@sha256:92999aea37688157a53a40bfcb187c30f317422e028045fd5fc5c548fde9e626",
        "public_url_bridge_image": "docker.io/alpine/socat:1.8.0.3@sha256:a26f4bcee25ad4a4096ce91e596c0a2fffcbb51f7fd198dd87a5c86eae66f0e1",
        "dependency_lock": "services/eudi-wallet-harness/gradle.lockfile",
        "dependency_verification": "services/eudi-wallet-harness/gradle/verification-metadata.xml"
      },
      "libraries": {
        "oid4vp": {
          "repository": "https://github.com/eu-digital-identity-wallet/eudi-lib-jvm-openid4vp-kt.git",
          "release": "v0.15.1",
          "version": "0.15.1",
          "commit": "4a695477b66040229c347d3255099b9f702ec929",
          "maven_coordinate": "eu.europa.ec.eudi:eudi-lib-jvm-openid4vp-kt:0.15.1"
        },
        "oid4vci": {
          "repository": "https://github.com/eu-digital-identity-wallet/eudi-lib-jvm-openid4vci-kt.git",
          "release": "v0.13.0",
          "version": "0.13.0",
          "commit": "07dc0b96dcd5c56197414c80c0fb70ce0d4f377d",
          "maven_coordinate": "eu.europa.ec.eudi:eudi-lib-jvm-openid4vci-kt:0.13.0"
        },
        "sd_jwt": {
          "repository": "https://github.com/eu-digital-identity-wallet/eudi-lib-jvm-sdjwt-kt.git",
          "release": "v0.20.1",
          "version": "0.20.1",
          "commit": "e8a94cb6114efc73812843fb1338913eac427675",
          "maven_coordinate": "eu.europa.ec.eudi:eudi-lib-jvm-sdjwt-kt:0.20.1"
        },
        "mdoc": {
          "repository": "https://github.com/openwallet-foundation/multipaz.git",
          "release": "0.100.0",
          "version": "0.100.0",
          "commit": "7c0988bee3384d13a0732e0c33336ae0faf3b863",
          "maven_coordinate": "org.multipaz:multipaz-jvm:0.100.0"
        }
      }
    }
  },
  "coverage": {
    "issuance": ["sd_jwt_vc", "mso_mdoc"],
    "presentation": ["sd_jwt_vc", "mso_mdoc"],
    "request_object_trust": ["signed_jar_x509_hash_pkix"],
    "response_mode": ["direct_post.jwt"],
    "wallet_key_attestation": ["jwt_proof_x5c_profile_trust"],
    "negative": [
      "missing_holder_binding_key",
      "replayed_response",
      "invalid_signature",
      "expired_request"
    ]
  },
  "required_evidence": {
    "eudi.oid4vci.mdoc-issuance.v1": {
      "claims": ["issuance:mso_mdoc"]
    },
    "eudi.oid4vp.mdoc-device-response.v1": {
      "claims": ["presentation:mso_mdoc"]
    },
    "eudi.oid4vp.haip.resolve-dispatch.v1": {
      "claims": [
        "issuance:sd_jwt_vc",
        "presentation:sd_jwt_vc",
        "request_object_trust:signed_jar_x509_hash_pkix",
        "response_mode:direct_post.jwt"
      ]
    },
    "eudi.sd-jwt.missing-holder-binding-key.v1": {
      "claims": ["negative:missing_holder_binding_key"]
    },
    "eudi.oid4vp.replayed-response.v1": {
      "claims": ["negative:replayed_response"]
    },
    "eudi.oid4vp.invalid-signature.v1": {
      "claims": ["negative:invalid_signature"]
    },
    "eudi.oid4vp.expired-request.v1": {
      "claims": ["negative:expired_request"]
    },
    "eudi.oid4vci.key-attestation-jwt-proof.v1": {
      "claims": ["wallet_key_attestation:jwt_proof_x5c_profile_trust"]
    }
  },
  "compatibility_only": {
    "negative_response_mutation": {
      "evidence": [
        "eudi.oid4vp.replayed-response.v1",
        "eudi.oid4vp.invalid-signature.v1"
      ],
      "reason": "The official EUDI library creates the holder-bound presentation. The test facade replays or mutates those exact bytes only after resolution so the production Marty callback can be tested deterministically; these cases are not claimed as official-library dispatch evidence."
    }
  },
  "target": "digest-pinned EUDI components against the public Marty gateway and normal issuer/verifier flows"
}
